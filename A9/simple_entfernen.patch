-define di_GoodWe_Resync notify 1s_2s_timer:.* {my $cur=ReadingsVal("DOIF_GoodWe_simple","state","?");;my $prev=ReadingsVal("di_GoodWe_Resync","laststate","?");;if($prev eq "disabled" && $cur ne "disabled"){fhem("setreading DOIF_GoodWe_simple last_mode_5877 -999");;fhem("setreading DOIF_GoodWe_simple last_mode_5876 -999");;fhem("setreading DOIF_GoodWe_simple last_p1 -999");;fhem("setreading DOIF_GoodWe_simple last_p2 -999");;fhem("setreading DOIF_GoodWe_simple last_pd1 -999");;fhem("setreading DOIF_GoodWe_simple last_pd2 -999");;fhem("setreading DOIF_GoodWe_simple last_send_c 0");;fhem("setreading DOIF_GoodWe_simple last_send_d 0");;Log 3, "GoodWe_Resync: erzwungen nach Enable";;}if($cur ne $prev){fhem("setreading di_GoodWe_Resync laststate $cur");;}}
-setuuid di_GoodWe_Resync 6a9c0477-f33f-0e4e-9d5f-238cb1180e958c3b
 define fhempy_buttons weblink htmlCode { "<div><a href=\"/fhem?cmd.dummy=attr fhempy_local disable 1
 setuuid fhempy_buttons 6aa0efba-f33f-0e4e-92fb-668947a24c01345d
-define di_GoodWe_NachtFahrplan notify 1s_2s_timer:.*\
-{\
-my $DEV = "di_GoodWe_NachtFahrplan";;\
-my @t = localtime();;\
-my $hour = $t[2];;\
-\
-my $DEV_5877 = "GoodWe_Garage_Haus_West_5877";;\
-my $DEV_5876 = "GoodWe_Haus_Ost_Mitte_5876";;\
-\
-my $cap1 = ReadingsNum("EMS_Control","capacity1",10);;\
-my $cap2 = ReadingsNum("EMS_Control","capacity2",5);;\
-my $socMin1 = ReadingsNum("EMS_Control","socMin1",2);;\
-my $socMin2 = ReadingsNum("EMS_Control","socMin2",2);;\
-my $soc1 = ReadingsNum($DEV_5877,"SOC",0);;\
-my $soc2 = ReadingsNum($DEV_5876,"SOC",0);;\
-\
-my $frei1 = int(($soc1 - $socMin1) / 100 * $cap1 * 1000);;\
-my $frei2 = int(($soc2 - $socMin2) / 100 * $cap2 * 1000);;\
-$frei1 = 0 if($frei1 < 0);;\
-$frei2 = 0 if($frei2 < 0);;\
-\
-my $SOLO_WH = ReadingsNum("EMS_Control","nachtSoloSchwelleWh",500);;\
-my $SOLO_W = ReadingsNum("EMS_Control","nachtZielSoloW",100);;\
-my $SWAP_WH = ReadingsNum("EMS_Control","nachtSwapSchwelleWh",300);;\
-\
-my $inWindow = ($hour >= 19 || $hour < 8) ? 1 : 0;;\
-my $active = ReadingsNum($DEV,"active",0);;\
-\
-if($inWindow && !$active)\
-{\
-fhem("set DOIF_GoodWe_simple disable");;\
-fhem("setreading $DEV active 1");;\
-fhem("setreading $DEV applied_mode -1");;\
-fhem("setreading $DEV applied_watt -1");;\
-fhem("setreading $DEV applied_dev none");;\
-my $start_master = ReadingsVal("DOIF_GoodWe_simple","master_discharger",$DEV_5877);;\
-$start_master = $DEV_5877 if($start_master ne $DEV_5877 && $start_master ne $DEV_5876);;\
-fhem("setreading $DEV nacht_master $start_master");;\
-Log 3,"NachtFahrplan: Start Master=$start_master (Rotation) frei1=$frei1 frei2=$frei2";;\
-}\
-\
-if(!$inWindow && $active)\
-{\
-fhem("set $DEV_5877 EMSPowerMode 1");;\
-fhem("set $DEV_5876 EMSPowerMode 1");;\
-fhem("setreading $DEV active 0");;\
-fhem("set DOIF_GoodWe_simple enable");;\
-Log 3,"NachtFahrplan: Ende 8 Uhr, DOIF_GoodWe_simple wieder aktiv";;\
-}\
-\
-if($inWindow)\
-{\
-my $master_dev = ReadingsVal($DEV,"nacht_master","");;\
-if($master_dev ne $DEV_5877 && $master_dev ne $DEV_5876)\
-{\
-$master_dev = ReadingsVal("DOIF_GoodWe_simple","master_discharger",$DEV_5877);;\
-$master_dev = $DEV_5877 if($master_dev ne $DEV_5877 && $master_dev ne $DEV_5876);;\
-fhem("setreading $DEV nacht_master $master_dev");;\
-}\
-\
-my $frei_master = ($master_dev eq $DEV_5877) ? $frei1 : $frei2;;\
-my $frei_slave = ($master_dev eq $DEV_5877) ? $frei2 : $frei1;;\
-\
-if($frei_master < $SWAP_WH && $frei_slave >= $SOLO_WH)\
-{\
-$master_dev = ($master_dev eq $DEV_5877) ? $DEV_5876 : $DEV_5877;;\
-fhem("setreading $DEV nacht_master $master_dev");;\
-Log 3,"NachtFahrplan: Master leer, Wechsel auf $master_dev";;\
-$frei_master = ($master_dev eq $DEV_5877) ? $frei1 : $frei2;;\
-$frei_slave = ($master_dev eq $DEV_5877) ? $frei2 : $frei1;;\
-}\
-\
-my $slave_dev = ($master_dev eq $DEV_5877) ? $DEV_5876 : $DEV_5877;;\
-my $solo = ($frei_slave < $SOLO_WH) ? 1 : 0;;\
-\
-my $full;;\
-if($hour >= 19 && $hour < 22) { $full = 500;; }\
-elsif($hour >= 6 && $hour < 8) { $full = 500;; }\
-else { $full = 100;; }\
-\
-$full = $SOLO_W if($solo);;\
-\
-my $ok = ReadingsNum("DOIF_nacht_einspeis","nacht_einspeis_erlaubt",0);;\
-my $socok = ReadingsNum("DOIF_nacht_einspeis","dbg_soc_ausreichend",0);;\
-\
-my $mode;;\
-my $watt;;\
-my $tier;;\
-if($ok) { $mode = 10;; $watt = $full;; $tier = $solo ? "solo" : "voll";; }\
-elsif($socok) { $mode = 10;; $watt = int($full/2);; $tier = $solo ? "solo_kritisch" : "kritisch";; }\
-else { $mode = 1;; $watt = 0;; $tier = "leer";; }\
-\
-my $applied_mode = ReadingsNum($DEV,"applied_mode",-1);;\
-my $applied_watt = ReadingsNum($DEV,"applied_watt",-1);;\
-my $applied_dev = ReadingsVal($DEV,"applied_dev","none");;\
-\
-if($applied_dev ne $master_dev)\
-{\
-fhem("set $slave_dev EMSPowerMode 1");;\
-fhem("setreading $DEV applied_dev $master_dev");;\
-fhem("setreading $DEV applied_mode -1");;\
-fhem("setreading $DEV applied_watt -1");;\
-$applied_mode = -1;;\
-$applied_watt = -1;;\
-Log 3,"NachtFahrplan: Slave=$slave_dev auf Mode1, Master=$master_dev";;\
-}\
-\
-if($applied_mode != $mode || $applied_watt != $watt)\
-{\
-fhem("set $master_dev EMSPowerMode $mode");;\
-if($mode == 10) { fhem("set $master_dev EMSPowerWatt $watt");; }\
-fhem("setreading $DEV applied_mode $mode");;\
-fhem("setreading $DEV applied_watt $watt");;\
-fhem("setreading $DEV tier $tier");;\
-Log 3,"NachtFahrplan: ${hour}Uhr Tier=$tier Mode=$mode Ziel=${watt}W Master=$master_dev";;\
-}\
-\
-fhem("setreading $DEV frei_5877 $frei1");;\
-fhem("setreading $DEV frei_5876 $frei2");;\
-fhem("setreading $DEV solo $solo");;\
-}\
-}\
-
-setuuid di_GoodWe_NachtFahrplan 6aa1427f-f33f-0e4e-1060-b3a954131a2c5524
-attr di_GoodWe_NachtFahrplan disable 1
